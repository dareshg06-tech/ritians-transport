// Elite Fleet Tracking — Prisma schema
// SQLite (single-file DB). Tables map cleanly to the spec in section 11.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("admin") // "admin" | "driver"
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id            String   @id @default(cuid())
  vehicleNumber String   @unique
  vehicleName   String
  vehicleType   String   @default("bus")
  driverName    String?
  routeNo       String?  // e.g. "R01"
  status        String   @default("offline") // live | idle | offline | tracking
  lastLat       Float?
  lastLng       Float?
  lastSpeed     Float?
  lastHeading   Float?
  lastAccuracy  Float?
  lastAltitude  Float?
  lastSeenAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  locations     VehicleLocation[]
  sessions      TrackingSession[]
  stopCrossings StopCrossing[]

  @@index([status])
  @@index([routeNo])
}

model VehicleLocation {
  id          String   @id @default(cuid())
  vehicleId   String
  latitude    Float
  longitude   Float
  accuracy    Float?
  speed       Float?
  heading     Float?
  altitude    Float?
  isSimulated Boolean  @default(false)
  recordedAt  DateTime @default(now())
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, recordedAt])
}

model TrackingSession {
  id         String    @id @default(cuid())
  vehicleId  String
  startedAt  DateTime  @default(now())
  stoppedAt  DateTime?
  status     String    @default("active") // active | stopped
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, startedAt])
  @@index([status])
}

model StopCrossing {
  id          String   @id @default(cuid())
  vehicleId   String
  routeNo     String
  stopName    String
  stopLat     Float
  stopLng     Float
  crossedAt   DateTime @default(now())
  sequence    Int
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, crossedAt])
  @@index([routeNo, sequence])
}

model Notification {
  id          String   @id @default(cuid())
  title       String
  body        String
  routeNo     String?  // null = broadcast to all
  recipients  Int      @default(0)
  createdAt   DateTime @default(now())
}

model Feedback {
  id          String   @id @default(cuid())
  type        String   // complaint | feedback
  message     String
  tags        String   // comma-separated
  studentName String?
  routeNo     String?
  createdAt   DateTime @default(now())
}

model SOSAlert {
  id          String   @id @default(cuid())
  studentName String
  registerNo  String
  routeNo     String?
  message     String
  location    String?
  status      String   @default("active") // active | resolved
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
}

model AttendanceRecord {
  id           String   @id @default(cuid())
  studentName  String
  registerNo   String
  routeNo      String
  boardingPoint String?
  status       String   // present | absent | late
  markedAt     DateTime @default(now())
  markedBy     String   // driver | ai-camera | manual
}

model FaceRegistration {
  id           String   @id @default(cuid())
  studentName  String
  registerNo   String
  routeNo      String?
  imageData    String   // base64 thumbnail
  createdAt    DateTime @default(now())
}
